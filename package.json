{
  "name": "datapact",
  "version": "0.1.0",
  "description": "Offline data-contract runtime: lint an Open Data Contract Standard contract, validate a CSV against it in your browser or in CI, and expose it to agents over MCP. No warehouse connection, no upload.",
  "type": "module",
  "author": "svx",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./src/cli.ts"
  ],
  "private": true,
  "bin": {
    "datapact": "src/cli.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build:site": "node scripts/build-site.mjs",
    "check:site": "node scripts/check-site.mjs"
  },
  "keywords": [
    "data-contract",
    "odcs",
    "data-quality",
    "csv",
    "validation",
    "schema",
    "data-engineering",
    "mcp",
    "agents",
    "cli",
    "sarif",
    "bun"
  ],
  "license": "MIT",
  "repository": "https://github.com/srivtx/datapact",
  "homepage": "https://srivtx.github.io/datapact",
  "bugs": {
    "url": "https://github.com/srivtx/datapact/issues"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "files": [
    "src",
    "spec",
    "install.sh",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "esbuild": "^0.25.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "yaml": "^2.6.1"
  }
}
